# Shared environment exports for LLAC
# This file is pure bash and safe to source from both .envrc and nix shellHook.

###############################
# GLOBAL / EXPECTED VARIABLES #
###############################

export CORES=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)
export ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export CUR_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"

# Builds
export VERILATOR_PREFIX="$ROOT/bin/verilator"
export RISCV_INSTALL_PREFIX="$ROOT/bin/riscv"
export AWK="$(command -v gawk || command -v awk)" # Ensure GNU Awk is used by the build system

##########################
# CONFIGURABLE / OPTIONS #
##########################

# Branch policies
export LENIENT_BRANCHES="^(.*WIP.*)|(.*research.*)|(devops)|(security)$"

# Python behavior
export PYTHON_ENV="python-stable-opt"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1

# Ensure working tree is importable and force pytest to use project config
export PYTHONPATH="$ROOT/Src:${PYTHONPATH:-}"
export PYTEST_ADDOPTS="-c $ROOT/Src/pyproject.toml ${PYTEST_ADDOPTS:-}"

# Git hooks
export RUFF_TO_CHECK="$(git ls-files | grep -oP '.+[^//]\w+\.py$' | grep -v 'test\.py$')"

# Tooling defaults
export VERILATOR_LINT_OFF=1
