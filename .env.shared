#!/bin/bash
# Shared environment exports for LLAC
# This file is pure bash and safe to source from both .envrc and nix shellHook.

###############################
# GLOBAL / EXPECTED VARIABLES #
###############################

export CORES=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)
export ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export CUR_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"

##########
# BUILDS #
##########

export FAST_BUILD=0

# FIX: current riscv-gnu-toolchain build seems to complete
# (I.e. produce valid elf binary) but with errors
# Use these as a workaround for now
export VERILATOR_BUILD_CAN_SOFTFAIL=0
export RISCV_GNU_TOOLCHAIN_BUILD_CAN_SOFTFAIL=1
export YOSYS_BUILD_CAN_SOFTFAIL=0

export VERILATOR_PREFIX="$ROOT/bin/verilator"
export RISCV_INSTALL_PREFIX="$ROOT/bin/riscv"
export YOSYS_PREFIX="$ROOT/bin/yosys"
export AWK="$(command -v gawk || command -v awk)" # Ensure GNU Awk is used by the build system

##########################
# CONFIGURABLE / OPTIONS #
##########################

# Nix
export NIXPKGS_ALLOW_UNFREE=1
export NIX_CONFIG="warn-dirty = false"

# Branch policies
export LENIENT_BRANCHES="^(.*WIP.*)|(.*research.*)|(devops)|(security)$"

# Python behavior
export PYTHON_ENV="python-stable-opt"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1

# Ensure working tree is importable and force pytest to use project config
export PYTHONPATH="$ROOT/Src:${PYTHONPATH:-}"
export PYTEST_ADDOPTS="-c $ROOT/Src/pyproject.toml ${PYTEST_ADDOPTS:-}"

# Git hooks
export RUFF_TO_CHECK="$(git ls-files | grep -oP '.+[^//]\w+\.py$' | grep -v 'test\.py$')"

# Tooling defaults
export VERILATOR_LINT_OFF=1

# Debug
export LOCK_DEBUG=0

#############
# FUNCTIONS #
#############

show_last_line_inplace() {
    # Usage: some_command 2>&1 | show_last_line_inplace "[prefix] "
    # - Rewrites the same terminal line with the most recent line from stdin.
    # - If stdout isn't a TTY, it falls back to a plain passthrough (cat), unless FORCE_INLINE_OUTPUT=1.
    local raw_prefix="${1-}"
    local bold_on=$'\033[1m'
    local bold_off=$'\033[22m'
    local italics=$'\033[3m'
    local reset=$'\033[0m'

    if [[ ! -t 1 && -z "${FORCE_INLINE_OUTPUT:-}" ]]; then
        cat
        return 0
    fi

    trap 'printf "\n"' INT TERM

    local cols=80
    if [[ -n "${COLUMNS:-}" ]]; then
        cols=${COLUMNS}
    elif command -v tput >/dev/null 2>&1; then
        cols=$(tput cols 2>/dev/null || echo 80)
    fi

    local line disp
    while IFS= read -r line; do
        disp="${line##*$'\r'}"
        local max_len=$(( cols > 1 ? cols - 1 : 1 ))
        local len_prefix=${#raw_prefix}

        printf '\r\033[J'
        if [[ -n "$raw_prefix" && $len_prefix -lt $max_len ]]; then
            local avail=$(( max_len - len_prefix ))
            local msg="$disp"
            if (( ${#msg} > avail )); then
                local keep=$(( avail > 3 ? avail - 3 : avail ))
                msg="...${msg: -$keep}"
            fi
            printf '%s%s%s%s%s' "$italics" "$bold_on" "$raw_prefix" "$bold_off" "${msg}${reset}"
        else
            # Prefix doesn't fit or is empty: show tail of combined text
            local combined
            if [[ -n "$raw_prefix" ]]; then
                combined="$raw_prefix$disp"
            else
                combined="$disp"
            fi
            if (( ${#combined} > max_len )); then
                local keep=$(( max_len > 3 ? max_len - 3 : max_len ))
                combined="...${combined: -$keep}"
            fi
            printf '%s%s%s' "$italics" "$combined" "$reset"
        fi
    done
    printf '\n'
}
export -f show_last_line_inplace

create_pre_commit_marker() {
    touch "$ROOT/.commit"
}

destroy_pre_commit_marker() {
    [ -f "$ROOT/.commit" ] || return 0
    rm "$ROOT/.commit"
}

add_file_in_pre_commit() {
    [ -f "$ROOT/.commit" ] || return 0
    git add "$1"
    git commit --amend -C HEAD --no-verify
}
export -f create_pre_commit_marker destroy_pre_commit_marker add_file_in_pre_commit
