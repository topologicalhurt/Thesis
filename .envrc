# Load nix-direnv integration (downloaded and cached by direnv)
source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/latest/direnvrc"

# Enter the flake dev shell for this directory
use flake

if [ -f "$ROOT/.env.shared" ]; then
	# shellcheck disable=SC1090
	. "$ROOT/.env.shared"
fi

run_tests() {
	bash "$ROOT/.github/hooks/run_tests.sh" "$@"
}
export -f run_tests 2>/dev/null || true

clean_build() {
	rm -rf "$ROOT/bin"/*
}
export -f clean_build 2>/dev/null || true
