# Load nix-direnv integration (downloaded and cached by direnv)
source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/latest/direnvrc"

# Enter the flake dev shell for this directory
use flake

#########################################
# GLOBAL ENV VARIABLES / BUILD SETTINGS #
#########################################

export ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export CUR_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"

if [ -f "$ROOT/.env.shared" ]; then
	# shellcheck disable=SC1090
	. "$ROOT/.env.shared"
fi

###########################
# PER-PROJECT VENV SETUP  #
###########################

run_tests() {
	bash "$ROOT/.github/hooks/pre_commit/run_tests.sh" "$@"
}
export -f run_tests 2>/dev/null || true
